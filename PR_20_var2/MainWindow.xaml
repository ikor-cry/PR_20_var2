<Window x:Class="PR_20_var2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Справочник фильмов" Height="450" Width="600" 
        WindowStartupLocation="CenterScreen"
        Background="#F4F4F4">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15" VerticalAlignment="Center">
            <TextBlock Text="Выберите жанр:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>

            <ComboBox x:Name="GenreCombo" 
                      Width="200" 
                      ItemsSource="{Binding Genres}" 
                      SelectionChanged="GenreCombo_SelectionChanged"
                      Padding="5"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1.5*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header=" Фильмы " Margin="0,0,10,0" FontWeight="Bold">
                <ListBox x:Name="FilmList" 
                         ItemsSource="{Binding FilteredFilms}" 
                         DisplayMemberPath="Title"
                         Margin="5"/>
            </GroupBox>

            <GroupBox Grid.Column="1" Header=" Описание " FontWeight="Bold">
                <TextBlock x:Name="DescriptionText" 
                           Text="Выберите фильм из списка, чтобы прочитать описание..." 
                           TextWrapping="Wrap" 
                           Margin="10" 
                           Foreground="Gray"/>
            </GroupBox>
        </Grid>

        <Button Grid.Row="2" 
                Content="Посмотреть описание" 
                Click="ShowDescription_Click"
                Height="40" Margin="0,15,0,0"
                Background="#2196F3" Foreground="White" FontWeight="Bold" FontSize="14"/>
    </Grid>
</Window>